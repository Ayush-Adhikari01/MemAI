# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Backend ONLY - Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Supabase Configuration (Get from Supabase project settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# JWT Secret (Matches Supabase JWT Secret if verifying custom tokens)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Memory Retrieval Tuning
MEMORY_SIMILARITY_THRESHOLD=0.45
MEMORY_MAX_RETRIEVED=5
MEMORY_AUTO_EXTRACT=true
